# Copy to .env and fill in before running docker-compose up.
DJANGO_SECRET_KEY=
DB_PASSWORD=
DEBUG=False
# localhost/127.0.0.1 are always allowed automatically (needed for the
# internal Docker healthcheck) — this only needs your actual public domain.
ALLOWED_HOSTS=your-domain.example
# Optional — commented out means the built-in localhost/127.0.0.1 default
# (ports 5173/4173, matching the Vite dev server) applies, so local
# testing works with no changes needed here. Uncomment and set your real
# domain for a public deployment.
# CORS_ORIGINS=https://your-domain.example

# Optional — number of reverse proxies in front of the API, used to find
# the real client IP for rate limiting. Default 1 (Caddy, as documented).
# Set 0 only if gunicorn is exposed directly with no proxy.
# NUM_PROXIES=1

# "public" or "private" — the one setting that governs deployment tier,
# read by both the backend AND the web build (see docker-compose.yml) from
# this single value, rather than several independent flags you'd have to
# remember to keep consistent with each other.
#
# "public": anonymous, internet-facing, no media uploads at all (photos or
# video) — see README.md's Photo Safety section for why. This is the safe
# default; an unrecognised value falls back to "public", not "private".
#
# "private": for a deployment with a known, vetted, accountable population
# (an org's own staff or contacts) — media uploads enabled, and the
# "Private exchange" framing appears in CreateDrop. Media uploads on
# "private" still have no content-scanning wired up (that needs your own
# provider credentials — Thorn Safer, Google CSAI Match, Microsoft
# PhotoDNA — nobody can supply that on your behalf); this mode is
# appropriate specifically because the population is vetted by whoever
# runs the deployment, not because the risk has been technically solved.
DEPLOYMENT_MODE=public

# Independent of DEPLOYMENT_MODE above — this gates who can reach the
# instance AT ALL, a genuinely separate concern from what feature set is
# enabled. Blank (the default) means no gate — every request goes
# straight through, exactly how this project has always worked. Set a
# single long, random, shared value (`make secrets` will generate one)
# to require it before anything else is reachable, on public OR private.
# See README.md's "The private-access gate" section for the full design
# and why it's one shared secret rather than a per-person credential —
# revoking one person means rotating this and re-sharing the new value
# with everyone else.
PRIVATE_ACCESS_CODE=

# The following are only ever read when DEPLOYMENT_MODE=private above —
# on "public" these stay hard-fixed at this project's long-standing
# defaults (shown here) regardless of what you set below, so a stray or
# copy-pasted value here can't accidentally weaken the public instance's
# retention or cap promises. Each is read by both the backend (actual
# enforcement) and the web build (matching UI limits) from this single
# value — see docker-compose.yml.
MAX_DROP_LIFETIME_HOURS=336
MAX_ACTIVE_DROPS_PER_IDENTITY=30
MAX_ANON_DROPS_PER_IP=1
MAX_PHOTOS_PER_DROP=2
MAX_PHOTO_SIZE_MB=5
MAX_VIDEOS_PER_DROP=1
MAX_VIDEO_SIZE_MB=100
MAX_MESSAGE_LENGTH=20000
MAX_MESSAGES_PER_DROP=100

# ONE url only — not comma-separated like CORS_ORIGINS above. Baked into the
# built JS at Docker build time, not read at container startup, so changing
# this needs `make build` (or `make up`, which rebuilds), never just a
# restart. For local testing: VITE_API_URL=http://localhost:8000
VITE_API_URL=https://api.your-domain.example

# Leave both blank to skip creating an admin/moderation account entirely.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
