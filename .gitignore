# Generated locally the moment anyone actually runs this — never meant to
# be committed, and easy to do by accident with a plain `git add .`
__pycache__/
*.pyc
node_modules/
db.sqlite3
*.log
.vscode/
.idea/

# Machine-specific compose overrides (e.g. the hosting setup binds ports to a
# private IP this way) — never part of the shared config.
docker-compose.override.yml
