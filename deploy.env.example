# Settings for ./deploy.sh. Copy to deploy.env (gitignored) and fill in.
# Read on YOUR machine only — this file is never copied to the server.
# Server secrets (Django key, DB password, admin password) are generated on
# the server itself at first deploy and never leave it.

# The server's public IPv4 address (or a hostname that resolves to it).
SERVER=203.0.113.10

# Two subdomains, both with DNS already pointing at SERVER.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Let's Encrypt account email — used only for certificate-expiry warnings.
ACME_EMAIL=you@example.com

# Where the server pulls code from, and which release. Use a tag (v1.0.0)
# for real deploys; a branch name (main) also works.
REPO_URL=https://github.com/paxiimus/deaddrop-privacy.git
REF=main

# public = anonymous, no media uploads. Read README.md before choosing private.
DEPLOYMENT_MODE=public

# Block the United Kingdom: UK IP addresses get a 451 page.
# ADMIN_ALLOW_IPS below are exempt, so you can still reach your own instance.
BLOCK_UK=false

# --- Optional ---------------------------------------------------------------

# Only these IPs/ranges can reach /admin/ (space-separated). Strongly
# recommended if you have a stable home or office IP.
# ADMIN_ALLOW_IPS="203.0.113.4 2001:db8:1234::/48"

# Days of nightly on-server database dumps to keep. Every day kept is a day
# expired drops still exist on disk, so keep it short.
# BACKUP_KEEP_DAYS=3

# If set, `./deploy.sh backup` encrypts downloaded dumps to this age key.
# AGE_RECIPIENT=age1...

# SSH user created on first run (root SSH login is then disabled).
# DEPLOY_USER=deploy
